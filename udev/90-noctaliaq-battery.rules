# NoctaliaQ: refuerza el limite de carga configurado (/etc/noctaliaq/battery.conf)
# cada vez que udev ve la bateria (arranque, resume, cambios de AC). Corre
# como root via udev, no necesita sudo ni permisos especiales.
SUBSYSTEM=="power_supply", ATTR{type}=="Battery", ACTION=="add", \
  RUN+="/usr/local/bin/noctaliaq-battery apply"

SUBSYSTEM=="power_supply", ATTR{type}=="Battery", ACTION=="change", \
  RUN+="/usr/local/bin/noctaliaq-battery apply"
